# SafeChill: ban the obvious ssh spammers, nobody else.
#
# This is not holding a door shut. sshd here is key-only (PasswordAuthentication no), so a brute force
# cannot succeed however long it runs. What it can do is fill the journal, and the journal now keeps
# eight days of xray access log — the record support questions get answered from. One scanner knocking
# every 100 seconds is thousands of lines a day competing for that space.
#
# mode = aggressive is required, not a preference. The scanners here never reach an authentication
# attempt: they open a connection and drop it, which sshd logs as "Connection closed by authenticating
# user root <ip> [preauth]". The default "normal" filter only matches real auth failures, so it would
# read this log and ban precisely nobody.
#
# findtime/maxretry are what separate a spammer from a person, and they are set wide on purpose. The
# scanner knocks ~36 times an hour; ten failures inside an hour is something a human being connecting
# from a new laptop, a different VPN or a phone will not do, especially since a successful key login
# leaves no failure at all. Someone who fumbles once or twice is never touched. bantime starts at an
# hour and doubles for repeat offenders up to a day, so a mistake in this file heals itself while a
# persistent scanner still gets shut out.
#
# ignoreip holds NO personal addresses — deliberately, since admin access comes from changing IPs and
# other VPNs, and a list of those would go stale and lock somebody out. What is here is structural:
# admin ssh through SafeChill arrives at sshd FROM THE NODE'S OWN ADDRESS (xray dials the local :22, so
# the auth log reads "Accepted publickey for root from <this node>"), and banning that would drop every
# tunnelled session at once with only the provider's console left. The other nodes are here because
# they ssh in to render configs and to restart a stuck xray. The AWG subnets are here for the same
# reason as the node's own address: a client on the tunnel reaches :22 from inside it.
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 ${SERVER_IP} ${SERVER_IP6} ${RU_HOST} ${EXIT2_HOST} ${AWG_NET4}.0/24 ${AWG_NET6}::/64
findtime = 1h
maxretry = 10
bantime = 1h
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 24h

[sshd]
enabled = true
mode = aggressive
