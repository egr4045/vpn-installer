# MyVPN — environment file.  Copy to .env and fill in (the install wizard does this for you).
# This file is COMMITTED with placeholders only. The real .env is gitignored.
# Precedence: built-in defaults < .env (this) < admin Settings (/data/settings.json).

# ── identity ──────────────────────────────────────────────────────────────────
BRAND=MyVPN
SERVER_IP=203.0.113.10                       # your server's public IPv4
SUB_HTTPS_BASE=https://admin.example.com/sub # base URL clients fetch subscriptions from

# ── domains (role: admin|cdn|direct|apex) — usually set via the admin Domains page ──
# Stored as JSON in /data/settings.json; the wizard seeds it. Example:
#   admin.example.com=admin, cdn.example.com=cdn(CF-proxied), direct.example.com=direct

# ── reality (xray) — GENERATED by the wizard with `xray x25519`; never share the private key ──
REALITY_PUBLIC_KEY=
REALITY_PRIVATE_KEY=
REALITY_SHORT_ID=
REALITY_SNI=gateway.icloud.com               # public real-site steal target.
# NB: do NOT use www.microsoft.com — its TLS handshake does not complete through
# REALITY (breaks at Certificate, ~9.6 KB chain behind Akamai), so every client
# is silently rejected. Verified working: gateway.icloud.com, dl.google.com,
# addons.mozilla.org, www.swift.com. Always test a new SNI before rolling it out.
REALITY_PORT=8443

# ── protocol endpoints ────────────────────────────────────────────────────────
CDN_DOMAIN=cdn.example.com
DIRECT_DOMAIN=direct.example.com
HY2_SNI=direct.example.com
TUIC_SNI=direct.example.com
HU_PATH=/probe
HY2_PORT=443
HY2_PORT_X=8444
TUIC_PORT=9443
TCP_PORT=2080

# ── admin auth — GENERATED by the wizard ──────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=                                  # `openssl rand -base64 18`
SECRET_KEY=                                  # `openssl rand -hex 32`  (session signing)

# ── health & telegram ─────────────────────────────────────────────────────────
HEALTH_TOKEN=                                # `openssl rand -hex 16`  (client healthcheck bearer)
TG_BOT_TOKEN=                                # from @BotFather (optional)

# ── core control (defaults fit the shipped docker-compose) ─────────────────────
XRAY_CONTAINER=xray
SINGBOX_CONTAINER=sing-box
NGINX_CONTAINER=nginx
CERT_DIR=/etc/letsencrypt/live/example.com

# Provider-traffic widget (HOSTKEY preset etc.) is configured in the admin Settings page.
