# SafeChill VPN — exit node settings. Copy to vpn.env (gitignored) next to install.sh,
# or straight to /etc/safechill/vpn.env. Only DOMAIN is required.
BRAND=SafeChill
DOMAIN=direct.example.com        # A record must point at this server (REALITY SNI + Let's Encrypt)
EMAIL=                           # optional: Let's Encrypt expiry notices
TG_BOT_TOKEN=                    # optional: @BotFather token; write anything to the bot once and it binds to you
AWG_PORT=39217                   # AmneziaWG UDP port
AWG_NET4=10.8.0                  # tunnel /24 prefix
AWG_NET6=fd08:5afe:c411          # tunnel /64 prefix
TCP_PORT=8443                    # VLESS+TCP+REALITY fallback port
FALLBACK_SNI=gateway.icloud.com  # REALITY steal target for the fallback (NOT www.microsoft.com — its handshake breaks)
BLOCK_TORRENT=1                  # 1 = drop BitTorrent through xray (protects the hoster account)
# RU_HOST=                       # set by setup-ru.sh: IP of the Russian entry node
# RU_SNI=yandex.ru               # set by setup-ru.sh: whitelisted site the RU node pretends to be
