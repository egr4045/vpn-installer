# SafeChill VPN — exit node settings. Copy to vpn.env (gitignored) next to install.sh,
# or straight to /etc/safechill/vpn.env. Only DOMAIN is required.
BRAND=SafeChill
DOMAIN=direct.example.com        # A record must point at this server (REALITY SNI + Let's Encrypt)
EMAIL=                           # optional: Let's Encrypt expiry notices
TG_BOT_TOKEN=                    # optional: @BotFather token; write anything to the bot once and it binds to you
TG_CHAT_ID=                      # optional: alerts go to this chat/group id; otherwise the bot binds alerts to the first chat an admin writes in
TG_ADMIN_IDS=                    # Telegram user ids allowed to use the bot, COMMA separated (this file is sourced by sh)
# NODE_NAME=Амстердам            # how alerts and /status call this node (RU_NODE_NAME=Москва for the entry node)
EGRESS_PREFER=ipv4               # keep ipv4: Google geolocates Timeweb's IPv6 ranges as Russia (Gemini "not available", YouTube gl=RU)
# SERVICES="www.youtube.com ..."  # optional: override the list of sites probed from the exit node
AWG_PORT=39217                   # AmneziaWG UDP port
AWG_NET4=10.8.0                  # tunnel /24 prefix
AWG_NET6=fd08:5afe:c411          # tunnel /64 prefix
TCP_PORT=8443                    # VLESS+TCP+REALITY fallback port
FALLBACK_SNI=gateway.icloud.com  # REALITY steal target for the fallback (NOT www.microsoft.com — its handshake breaks)
BLOCK_TORRENT=1                  # 1 = drop BitTorrent through xray (protects the hoster account)
BOT_ENABLED=1                    # 0 on secondary nodes (only one node may poll the bot token)
# TW_API_TOKEN=                  # Timeweb Cloud API token: lets the bot rotate this node's IPv4 (/newip) and drop old ones
# TW_SERVER_ID=                  # this server's Timeweb id (for /newip)
# RU_HOST=                       # set by setup-ru.sh: IP of the Russian entry node
# RU_SNI=yandex.ru               # set by setup-ru.sh: whitelisted site the RU node pretends to be
# EXIT2_HOST= / EXIT2_DOMAIN=    # set by setup-exit2.sh: standby exit node (RU entry fails over to it automatically)
